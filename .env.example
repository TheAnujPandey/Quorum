# Quorum — Docker environment
# Copy to .env:  cp .env.example .env

# Database (Docker Compose overrides host to "postgres")
POSTGRES_URL=postgresql://quorum:quorum@localhost:5432/quorum

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Blob storage (MinIO in Docker)
STORAGE_BACKEND=s3
LOCAL_DATA_DIR=./data
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=quorum-uploads
MINIO_REGION=us-east-1

# Qdrant
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=quorum_chunks

# OpenAI (set via frontend Settings page, or here as fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=7
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
LLM_CONCURRENCY_LIMIT=10
ASK_TIMEOUT_SECONDS=120
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
EMBEDDING_MODEL_VERSION=bge-small-en-v1.5
